{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/pathogen.schema.json",
  "title": "Pathogen (kb/pathogens/*.yaml)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "kind",
    "gram",
    "group",
    "resistance_mechanisms"
  ],
  "properties": {
    "kind": {
      "enum": [
        "bacterium",
        "virus"
      ]
    },
    "gram": {
      "enum": [
        "positive",
        "negative",
        "not_applicable"
      ]
    },
    "group": {
      "enum": [
        "typical",
        "atypical",
        "resistant",
        "anaerobe",
        "virus"
      ]
    },
    "resistance_mechanisms": {
      "$ref": "common.schema.json#/$defs/idList"
    }
  },
  "unevaluatedProperties": false
}
