{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/constraint.schema.json",
  "title": "Constraint (kb/constraints.yaml). mode exclude (default) removes every candidate that holds a matching drug; demote keeps the candidate, moves it behind same-tier candidates without a match and attaches a warning; warn keeps it in place and attaches a warning. File order is precedence.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "exclude",
    "reason_key"
  ],
  "properties": {
    "when": {
      "$ref": "common.schema.json#/$defs/condition"
    },
    "mode": {
      "enum": [
        "exclude",
        "demote",
        "warn"
      ]
    },
    "spare": {
      "type": "object",
      "description": "Components with this regimen role are left alone while the condition holds.",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "$ref": "common.schema.json#/$defs/role"
        },
        "when": {
          "$ref": "common.schema.json#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "exclude": {
      "type": "object",
      "description": "Drug selector; every given field must match.",
      "minProperties": 1,
      "properties": {
        "drug": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "class_group": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "beta_lactam_core": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "shares_r1_with_core": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "pregnancy": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "qt_risk": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "class_group_in_answer": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "license": {
          "type": "array",
          "items": {
            "enum": [
              "licensed",
              "not_licensed",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "monotherapy": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "reason_key": {
      "$ref": "common.schema.json#/$defs/i18nKey"
    }
  },
  "unevaluatedProperties": false
}
