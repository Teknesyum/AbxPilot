{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/spectrum-row.schema.json",
  "title": "Spectrum matrix row, drug x pathogen (kb/spectrum/*.csv)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "drug",
    "coverage"
  ],
  "properties": {
    "drug": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "enum": [
          "reliable",
          "variable",
          "none"
        ]
      }
    }
  },
  "unevaluatedProperties": false
}
