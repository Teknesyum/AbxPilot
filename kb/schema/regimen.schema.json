{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/regimen.schema.json",
  "title": "Regimen: one or more drugs, each with a dose reference (kb/regimens/*.yaml)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "components"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "drug",
          "dose",
          "role"
        ],
        "properties": {
          "drug": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "dose": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "role": {
            "$ref": "common.schema.json#/$defs/role"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
