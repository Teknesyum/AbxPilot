{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/guideline-set.schema.json",
  "title": "Guideline set (kb/guidelines/<set>/set.yaml)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [],
  "properties": {
    "extends": {
      "$ref": "common.schema.json#/$defs/id",
      "description": "Parent set. Its rows are inherited; a row with the same id replaces the inherited row in place, new rows are appended."
    }
  },
  "unevaluatedProperties": false
}
