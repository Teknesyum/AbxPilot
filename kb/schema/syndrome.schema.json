{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/syndrome.schema.json",
  "title": "Syndrome (kb/syndromes/*.yaml)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "pathogens",
    "questions",
    "derived"
  ],
  "properties": {
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Position in the syndrome list; the app opens on the first one."
    },
    "pathogens": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 20
    },
    "derived": {
      "type": "array",
      "description": "Yes/no flags computed from answers; decision tables may use them as condition columns.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "when": {
            "$ref": "common.schema.json#/$defs/condition"
          },
          "risk": {
            "enum": [
              "mrsa",
              "pseudomonas",
              "esbl"
            ],
            "description": "Marks the flag as a resistant-pathogen risk flag reported by the engine."
          },
          "pathogen": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Pathogen whose spectrum bar the risk flag highlights."
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "risk": [
            "pathogen"
          ],
          "pathogen": [
            "risk"
          ]
        }
      }
    }
  },
  "unevaluatedProperties": false
}
