{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/syndrome.schema.json",
  "title": "Syndrome (kb/syndromes/*.yaml)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "pathogens",
    "questions",
    "derived"
  ],
  "properties": {
    "pathogens": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 20
    },
    "derived": {
      "type": "array",
      "description": "Yes/no flags computed from answers; decision tables may use them as condition columns.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "when": {
            "$ref": "common.schema.json#/$defs/condition"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
