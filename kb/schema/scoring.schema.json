{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abxpilot.teknesyum.dev/scoring.schema.json",
  "title": "Comparison score weights (kb/scoring.yaml). The score only compares options in the same tier; it never changes the table's choice.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  ],
  "required": [
    "components",
    "aware_penalty",
    "coverage_value",
    "bioavailability_value",
    "resistance_penalty"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "weight",
          "rationale"
        ],
        "properties": {
          "id": {
            "enum": [
              "spectrum_fit",
              "breadth_penalty",
              "adverse_effects",
              "dosing_convenience",
              "oral_switch",
              "regional_resistance",
              "cost"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "aware_penalty": {
      "type": "object",
      "required": [
        "access",
        "watch",
        "reserve",
        "not_applicable"
      ],
      "properties": {
        "access": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "watch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reserve": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "not_applicable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "coverage_value": {
      "type": "object",
      "description": "Numeric value of each spectrum level; used by spectrum bars and spectrum_fit.",
      "required": [
        "reliable",
        "variable",
        "none"
      ],
      "properties": {
        "reliable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "variable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "none": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "bioavailability_value": {
      "type": "object",
      "description": "Numeric value of oral bioavailability; used by oral_switch.",
      "required": [
        "high",
        "moderate",
        "low",
        "none"
      ],
      "properties": {
        "high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "moderate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "none": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "resistance_penalty": {
      "type": "object",
      "description": "Penalty per regional resistance category; categories not listed count as zero.",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "unevaluatedProperties": false
}
