<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AbxPilot.UI.App"
             Name="AbxPilot"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AbxPilot.UI/Themes/Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://AbxPilot.UI/Tema/Theme.axaml"/>
    <StyleInclude Source="avares://AbxPilot.UI/Kabuk/KabukStilleri.axaml"/>
    <StyleInclude Source="avares://AbxPilot.UI/Themes/Controls.axaml"/>
  </Application.Styles>

</Application>
