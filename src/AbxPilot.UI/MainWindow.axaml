<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:AbxPilot.UI.Localization"
        xmlns:vm="using:AbxPilot.UI.ViewModels"
        xmlns:views="using:AbxPilot.UI.Views"
        xmlns:kabuk="using:AbxPilot.UI.Kabuk"
        x:Class="AbxPilot.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AbxPilot"
        Icon="avares://AbxPilot.UI/Assets/abxpilot.ico"
        MinWidth="{StaticResource WindowMinWidth}"
        MinHeight="{StaticResource WindowMinHeight}"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}"
        FontSize="{StaticResource FontSize2}"
        Foreground="{StaticResource TextBody}">

  <Window.Resources>
    <DrawingImage x:Key="LogoImage">
      <DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource IconLogoLeft}" Brush="{StaticResource Renk1}"/>
        <GeometryDrawing Geometry="{StaticResource IconLogoRight}" Brush="{StaticResource Renk2Text}"/>
      </DrawingGroup>
    </DrawingImage>
  </Window.Resources>

  <Border x:Name="WindowShell"
          Background="{StaticResource AppBg}"
          BorderBrush="{StaticResource BorderDefault}"
          BorderThickness="{StaticResource BorderWidth}"
          CornerRadius="{StaticResource WindowRadius}"
          ClipToBounds="True"
          UseLayoutRounding="True">
    <Panel>
      <Panel Classes="appbg"/>
      <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderDecorative}"
                BorderThickness="0,0,0,1">
          <kabuk:TitleBar x:Name="UstCubuk"
                          Logo="{StaticResource LogoImage}"
                          Ad1="{loc:Text app.name.first}"
                          Ad2="{loc:Text app.name.second}"
                          ImzaMetni="{loc:Text sig.brand}"
                          ImzaIpucu="{loc:Text sig.brandTitle}"
                          ImzaAdresi="{StaticResource LinkGitHub}"
                          DestekMetni="{loc:Text sig.support}"
                          DestekIpucu="{loc:Text sig.supportTitle}"
                          DestekAdresi="{StaticResource LinkSponsor}"
                          KucultMetni="{loc:Text window.minimize}"
                          BuyutMetni="{loc:Text window.maximize}"
                          KapatMetni="{loc:Text window.close}">
            <kabuk:TitleBar.Orta>
              <Panel x:Name="TitleNotice" Background="Transparent"
                     ToolTip.Tip="{loc:Text footer.disclaimer}"
                     auto:AutomationProperties.Name="{loc:Text footer.disclaimer}">
                <TextBlock x:Name="NoticeFull" Theme="{StaticResource Hint}" HorizontalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="{loc:Text footer.disclaimer}"/>
                <TextBlock x:Name="NoticeShort" Theme="{StaticResource Hint}" HorizontalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="False"
                           Text="{loc:Text footer.disclaimerShort}"/>
              </Panel>
            </kabuk:TitleBar.Orta>
            <kabuk:TitleBar.Ek>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                <Border VerticalAlignment="Center" IsVisible="{Binding HasDataVersion}"
                        BorderBrush="{StaticResource BorderDecorative}"
                        BorderThickness="{StaticResource BorderWidth}"
                        CornerRadius="{StaticResource Radius}"
                        Padding="{StaticResource InputPadding}"
                        MinHeight="{StaticResource TargetMin}">
                  <TextBlock Text="{Binding DataVersion}" VerticalAlignment="Center"
                             FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSize2}"
                             Foreground="{StaticResource TextBody}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Languages}" VerticalAlignment="Center"
                              auto:AutomationProperties.Name="{loc:Text titlebar.language}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LanguageOption">
                      <Button Theme="{StaticResource HeaderButton}"
                              Content="{Binding Label}"
                              Classes.selected="{Binding IsSelected}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectLanguageCommand}"
                              CommandParameter="{Binding Code}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </kabuk:TitleBar.Ek>
          </kabuk:TitleBar>
        </Border>

        <views:MainView/>
      </DockPanel>
    </Panel>
  </Border>
</Window>
