<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:AbxPilot.UI.Localization"
             xmlns:vm="using:AbxPilot.UI.ViewModels"
             xmlns:ch="using:AbxPilot.UI.Choreography"
             xmlns:ctl="using:AbxPilot.UI.Controls"
             xmlns:auto="using:Avalonia.Automation"
             x:Class="AbxPilot.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="Root"
             FontFamily="{StaticResource FontSans}"
             Foreground="{StaticResource TextBody}"
             TopLevel.AutoSafeAreaPadding="True">

  <Panel x:Name="Stage">

      <Panel x:Name="Body" Margin="{StaticResource PanelPadding}">

        <Grid x:Name="Main" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{StaticResource RowGap}">

          <Grid x:Name="AppBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto"
                ColumnSpacing="{StaticResource RowGap}" RowSpacing="{StaticResource FieldGap}">
            <Button x:Name="DrawerButton" Grid.Column="0" Theme="{StaticResource HeaderButton}"
                    IsVisible="{Binding IsCompact}"
                    Content="{loc:Text appbar.menu}"
                    Command="{Binding ToggleDrawerCommand}"/>
            <TextBlock x:Name="AppTitle" Grid.Column="1" Theme="{StaticResource H3}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SyndromeTitle}"/>
            <Button x:Name="GuidelineButton" Grid.Column="2" HorizontalAlignment="Left" Theme="{StaticResource HeaderButton}"
                    IsVisible="{Binding !IsLoading}"
                    Content="{Binding GuidelineName}"
                    ToolTip.Tip="{Binding SourceUrl}"
                    ToolTip.ServiceEnabled="{Binding SourceUrl, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button x:Name="SettingsButton" Grid.Column="3" Theme="{StaticResource HeaderButton}"
                    Classes.selected="{Binding IsSettingsOpen}"
                    Content="{loc:Text appbar.settings}"
                    Command="{Binding ToggleSettingsCommand}"/>
          </Grid>

          <Border x:Name="InlineDisclaimer" Grid.Row="1" Theme="{StaticResource Badge}"
                  HorizontalAlignment="Stretch"
                  auto:AutomationProperties.Name="{loc:Text footer.disclaimer}">
            <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text footer.disclaimer}"/>
          </Border>

          <Grid x:Name="Upper" Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="{StaticResource SectionGap}">
            <Border x:Name="SummaryCard" Grid.Column="0" Theme="{StaticResource Panel}"
                    Classes.consult="{Binding IsCaution}"
                    Classes.clear="{Binding IsNoAntibiotic}">
              <Panel>
                <Border x:Name="CardGlow" Classes="flash"/>
                <ScrollViewer x:Name="CardScroll" HorizontalScrollBarVisibility="Disabled" Padding="{Binding Source={StaticResource Space4}, Converter={x:Static ch:Converters.Gutter}}">
                <Panel>

                <StackPanel x:Name="LoadingState" Spacing="{StaticResource FieldStack}"
                            IsVisible="{Binding IsLoading}">
                  <TextBlock Theme="{StaticResource H2}" Text="{loc:Text card.title}"/>
                  <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text card.loadingText}"/>
                  <Panel x:Name="SkeletonHost" ClipToBounds="True">
                    <StackPanel Spacing="{StaticResource RowGap}">
                      <Border Theme="{StaticResource Skeleton}"/>
                      <Border Theme="{StaticResource SkeletonBar}"/>
                      <Border Theme="{StaticResource SkeletonBar}"/>
                    </StackPanel>
                    <Border x:Name="SkeletonSweep" HorizontalAlignment="Left"
                            Width="{StaticResource SidebarWidth}"
                            Background="{StaticResource NeonBlue10}"/>
                  </Panel>
                </StackPanel>

                <StackPanel x:Name="EmptyState" Spacing="{StaticResource FieldStack}"
                            IsVisible="{Binding IsEmpty}">
                  <TextBlock Theme="{StaticResource H2}" Text="{loc:Text card.title}"/>
                  <TextBlock Theme="{StaticResource H3}" Text="{loc:Text card.empty.title}"/>
                  <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{loc:Text card.empty.body}"/>
                  <Button x:Name="EmptyAction" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                          Content="{loc:Text card.empty.action}"/>
                </StackPanel>

                <StackPanel x:Name="ErrorState" Spacing="{StaticResource FieldStack}"
                            IsVisible="{Binding IsError}">
                  <TextBlock Theme="{StaticResource H2}" Text="{loc:Text card.title}"/>
                  <TextBlock Theme="{StaticResource DangerBody}" TextWrapping="Wrap" Text="{loc:Text card.error.title}"/>
                  <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding ErrorText}"/>
                  <Button x:Name="RetryButton" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                          Content="{loc:Text card.retry}"
                          Command="{Binding RetryCommand}"/>
                </StackPanel>

                <StackPanel x:Name="ResultState" Spacing="{StaticResource FieldStack}"
                            IsVisible="{Binding HasCard}">
                  <StackPanel Spacing="{StaticResource FieldGap}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource RowGap}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource RowGap}">
                        <TextBlock Theme="{StaticResource Label}" VerticalAlignment="Center" Text="{loc:Text card.title}"/>
                        <Panel IsVisible="{Binding HasFirstChoice}" VerticalAlignment="Center">
                          <Border Theme="{StaticResource WarningBadge}" IsVisible="{Binding IsUnreviewed}">
                            <TextBlock Theme="{StaticResource WarningBody}" Text="{Binding ReviewText}"/>
                          </Border>
                          <Border Theme="{StaticResource Badge}" IsVisible="{Binding !IsUnreviewed}">
                            <TextBlock Theme="{StaticResource Label}" Text="{Binding ReviewText}"/>
                          </Border>
                        </Panel>
                      </StackPanel>
                      <TextBlock x:Name="ChangeTag" Grid.Column="1" Classes="tag" Theme="{StaticResource Label}"
                                 Foreground="{StaticResource NeonBlue}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 TextWrapping="Wrap" TextAlignment="Right"
                                 Text="{Binding ChangeText}"/>
                    </Grid>
                    <TransitioningContentControl x:Name="Headline" Classes="headline drug"
                                                 Classes.caution="{Binding IsCaution}"
                                                 Classes.clear="{Binding IsNoAntibiotic}"
                                                 Content="{Binding Headline}">
                      <TransitioningContentControl.PageTransition>
                        <ch:NudgeTransition/>
                      </TransitioningContentControl.PageTransition>
                      <TransitioningContentControl.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                      </TransitioningContentControl.ContentTemplate>
                    </TransitioningContentControl>
                    <WrapPanel x:Name="DoseLine" IsVisible="{Binding HasFirstChoice}"
                               ItemSpacing="{StaticResource RowGap}" LineSpacing="{StaticResource FieldGap}">
                      <ItemsControl x:Name="SlotList" ItemsSource="{Binding Slots}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource FieldGap}"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ComponentSlot">
                            <StackPanel Classes="slot" Spacing="{StaticResource Space1}">
                              <WrapPanel ItemSpacing="{StaticResource FieldGap}" LineSpacing="{StaticResource Space1}">
                                <TextBlock Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding ShowName}" Text="{Binding DrugName}"/>
                                <ch:CountingText Classes="dose" Theme="{StaticResource MonoValue}" VerticalAlignment="Center" Amount="{Binding Amount}"/>
                                <TextBlock Theme="{StaticResource Body}" VerticalAlignment="Center" Text="{Binding Route}"/>
                                <TextBlock Theme="{StaticResource Body}" VerticalAlignment="Center" Text="{Binding Schedule}"/>
                              </WrapPanel>
                              <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding Extra}" IsVisible="{Binding HasExtra}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border x:Name="DurationBadge" Theme="{StaticResource Badge}">
                        <Panel>
                          <Border x:Name="DurationGlow" Classes="flash"/>
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource FieldGap}">
                            <TextBlock Theme="{StaticResource Label}" Text="{loc:Text card.duration}"/>
                            <TextBlock Theme="{StaticResource MonoValue}" Text="{Binding DurationText}"/>
                          </StackPanel>
                        </Panel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <TextBlock x:Name="RegionNotice" Theme="{StaticResource WarningBody}" TextWrapping="Wrap"
                             IsVisible="{Binding NoRegionData}" Text="{loc:Text card.regionNoData}"/>

                  <StackPanel x:Name="ConsultBlock" Spacing="{StaticResource FieldGap}" IsVisible="{Binding IsConsult}">
                    <TextBlock Theme="{StaticResource WarningBody}" TextWrapping="Wrap" Text="{Binding ConsultText}"/>
                    <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{loc:Text card.consult.body}"/>
                  </StackPanel>

                  <StackPanel x:Name="ReferralBlock" Spacing="{StaticResource FieldGap}" IsVisible="{Binding IsReferral}">
                    <TextBlock Theme="{StaticResource WarningBody}" TextWrapping="Wrap" Text="{Binding OutcomeText}"/>
                    <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding ReferralNote}"/>
                  </StackPanel>

                  <StackPanel x:Name="NoAntibioticBlock" Spacing="{StaticResource FieldGap}" IsVisible="{Binding IsNoAntibiotic}">
                    <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding OutcomeText}"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text card.noAntibiotic.body}"/>
                  </StackPanel>

                  <StackPanel x:Name="FirstChoice" Spacing="{StaticResource RowGap}" IsVisible="{Binding HasFirstChoice}">
                    <TextBlock Theme="{StaticResource Hint}" Text="{Binding SourceText}"/>

                    <StackPanel Spacing="{StaticResource Space1}" IsVisible="{Binding HasWarnings}">
                      <TextBlock Theme="{StaticResource Label}" Text="{loc:Text card.warnings}"/>
                      <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TextRow">
                            <StackPanel Spacing="{StaticResource Space1}">
                              <TextBlock Theme="{StaticResource WarningBody}" TextWrapping="Wrap" Text="{Binding Text}"/>
                              <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource Space1}">
                      <TextBlock Theme="{StaticResource Label}" Text="{Binding LicensesTitle}"/>
                      <ItemsControl ItemsSource="{Binding Licenses}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TextRow">
                            <TextBlock Theme="{StaticResource Hint}" Text="{Binding Text}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="{StaticResource FieldGap}">
                    <Button x:Name="TabAlternatives" Theme="{StaticResource HeaderButton}"
                            Classes.selected="{Binding IsAlternativesTab}"
                            Content="{Binding AlternativesHeader}"
                            Command="{Binding ShowTabCommand}" CommandParameter="alternatives"/>
                    <Button x:Name="TabRationale" Theme="{StaticResource HeaderButton}"
                            Classes.selected="{Binding IsRationaleTab}"
                            Content="{Binding RationaleHeader}"
                            Command="{Binding ShowTabCommand}" CommandParameter="rationale"/>
                  </StackPanel>

                  <TransitioningContentControl x:Name="TabHost" Content="{Binding CurrentTab}">
                    <TransitioningContentControl.PageTransition>
                      <CrossFade Duration="{StaticResource TBase}"/>
                    </TransitioningContentControl.PageTransition>
                    <TransitioningContentControl.DataTemplates>

                      <DataTemplate DataType="vm:AlternativesPage">
                        <StackPanel Spacing="{StaticResource FieldStack}">
                          <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text card.noAlternatives}"
                                     IsVisible="{Binding Owner.NoAlternatives}"/>
                          <ItemsControl x:Name="AlternativeList" ItemsSource="{Binding Owner.Alternatives}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource FieldGap}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AlternativeRow">
                                <Border Classes="alt" Classes.leaving="{Binding IsLeaving}"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderDecorative}"
                                        BorderThickness="{StaticResource BorderWidth}"
                                        CornerRadius="{StaticResource Radius}"
                                        Padding="{Binding Source={StaticResource Space3}, Converter={x:Static ch:Converters.Inset}}"
                                        ToolTip.ServiceEnabled="{Binding HasScore}"
                                        ToolTip.ShowDelay="0">
                                  <ToolTip.Tip>
                                    <StackPanel Spacing="{StaticResource Space1}">
                                      <TextBlock Theme="{StaticResource Label}" Text="{loc:Text score.label}"/>
                                      <TextBlock Theme="{StaticResource MonoValue}" Text="{Binding ScoreTotal}"/>
                                      <ItemsControl ItemsSource="{Binding ScoreParts}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:ScorePart">
                                            <DockPanel HorizontalSpacing="{StaticResource RowGap}">
                                              <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Text="{Binding Formula}"/>
                                              <TextBlock Theme="{StaticResource Body}" Text="{Binding Name}"/>
                                            </DockPanel>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text score.hint}"/>
                                    </StackPanel>
                                  </ToolTip.Tip>
                                  <StackPanel Spacing="{StaticResource Space1}">
                                    <DockPanel HorizontalSpacing="{StaticResource RowGap}">
                                      <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}"
                                                 Text="{Binding ScoreTotal}" IsVisible="{Binding ScoreInline}"/>
                                      <TextBlock Theme="{StaticResource Body}" FontWeight="{StaticResource WeightSemi}"
                                                 TextWrapping="Wrap" Text="{Binding Title}"/>
                                    </DockPanel>
                                    <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}"/>
                                    <TextBlock Theme="{StaticResource WarningBody}" Text="{Binding LeavingReason}"
                                               IsVisible="{Binding IsLeaving}"/>
                                    <ItemsControl ItemsSource="{Binding ScoreParts}" IsVisible="{Binding ScoreInline}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScorePart">
                                          <DockPanel HorizontalSpacing="{StaticResource RowGap}">
                                            <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Text="{Binding Formula}"/>
                                            <TextBlock Theme="{StaticResource Hint}" Text="{Binding Name}"/>
                                          </DockPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <StackPanel Spacing="{StaticResource FieldGap}" IsVisible="{Binding Owner.HasExcluded}">
                            <TextBlock Theme="{StaticResource Label}" Text="{Binding Owner.ExcludedHeader}"/>
                            <ItemsControl ItemsSource="{Binding Owner.Excluded}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="{StaticResource FieldGap}"/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExcludedRow">
                                  <StackPanel Spacing="{StaticResource Space1}">
                                    <TextBlock Theme="{StaticResource Body}" Text="{Binding Title}"/>
                                    <TextBlock Theme="{StaticResource WarningBody}" TextWrapping="Wrap" Text="{Binding Reason}"/>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>

                      <DataTemplate DataType="vm:RationalePage">
                        <StackPanel Spacing="{StaticResource FieldStack}">
                          <ItemsControl ItemsSource="{Binding Owner.Rationale}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource FieldGap}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TextRow">
                                <StackPanel Spacing="{StaticResource Space1}">
                                  <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Text}"/>
                                  <TextBlock Theme="{StaticResource Hint}" Text="{Binding Detail}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Theme="{StaticResource HeaderButton}" HorizontalAlignment="Left"
                                  Command="{Binding Owner.ToggleTraceCommand}">
                            <Panel>
                              <TextBlock Text="{loc:Text card.trace.show}" IsVisible="{Binding !Owner.IsTraceOpen}"/>
                              <TextBlock Text="{loc:Text card.trace.hide}" IsVisible="{Binding Owner.IsTraceOpen}"/>
                            </Panel>
                          </Button>
                          <ItemsControl ItemsSource="{Binding Owner.TraceRows}" IsVisible="{Binding Owner.IsTraceOpen}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource Space1}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TextRow">
                                <DockPanel HorizontalSpacing="{StaticResource RowGap}">
                                  <TextBlock DockPanel.Dock="Right" Theme="{StaticResource MonoValue}" Text="{Binding Detail}"/>
                                  <TextBlock Theme="{StaticResource Hint}" Text="{Binding Text}"/>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>

                    </TransitioningContentControl.DataTemplates>
                  </TransitioningContentControl>
                </StackPanel>
                </Panel>
                </ScrollViewer>
              </Panel>
            </Border>

            <Panel x:Name="SpectrumWide" Grid.Column="1">
              <Border x:Name="SpectrumStrip" Theme="{StaticResource Panel}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="{Binding Source={StaticResource Space4}, Converter={x:Static ch:Converters.Gutter}}">
                  <StackPanel Spacing="{StaticResource RowGap}">
                    <TextBlock Theme="{StaticResource H3}" Text="{loc:Text spectrum.title}"/>
                    <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text spectrum.hint}" IsVisible="{Binding HasSpectrum}"/>
                    <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text spectrum.empty}" IsVisible="{Binding !HasSpectrum}"/>
                    <ItemsControl x:Name="SpectrumList" ItemsSource="{Binding Spectrum}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="{StaticResource RowGap}"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpectrumRow">
                          <StackPanel Spacing="{StaticResource Space1}">
                            <DockPanel HorizontalSpacing="{StaticResource RowGap}">
                              <TextBlock DockPanel.Dock="Right" Theme="{StaticResource Label}" Text="{Binding LevelText}"/>
                              <Border DockPanel.Dock="Right" Theme="{StaticResource WarningBadge}"
                                      IsVisible="{Binding AtRisk}">
                                <TextBlock Theme="{StaticResource WarningBody}" Text="{Binding RiskText}"/>
                              </Border>
                              <TextBlock Theme="{StaticResource Body}" TextTrimming="CharacterEllipsis" Text="{Binding Name}"
                                         ToolTip.Tip="{Binding Name}"/>
                            </DockPanel>
                            <Panel Height="{StaticResource Space2}">
                              <Border Background="{StaticResource NeonBlue10}" CornerRadius="{StaticResource Radius}"/>
                              <Border Classes="fill" Classes.variable="{Binding IsVariable}"
                                      CornerRadius="{StaticResource Radius}"
                                      RenderTransform="{Binding Coverage, Converter={x:Static ch:Converters.ScaleX}}"/>
                            </Panel>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Panel>
          </Grid>

          <ScrollViewer x:Name="LowerScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" Margin="{Binding Source={StaticResource Space4}, Converter={x:Static ch:Converters.Overhang}}" Padding="{Binding Source={StaticResource Space4}, Converter={x:Static ch:Converters.Gutter}}">
            <StackPanel x:Name="Lower" Spacing="{StaticResource SectionGap}">
              <Panel x:Name="SpectrumNarrow" IsVisible="False"/>

              <Border x:Name="QuestionPanel" Theme="{StaticResource Panel}">
                <Border.Resources>
                  <DataTemplate x:Key="QuestionRowTemplate" x:DataType="vm:QuestionCard">
                    <Border Classes="qcard" Classes.changed="{Binding IsChanged}"
                            ctl:QuestionGrid.IsWide="{Binding IsWide}">
                      <ctl:QuestionRow LabelMin="{StaticResource QuestionLabelMin}"
                                       Spacing="{StaticResource RowGap}"
                                       IsFlexible="{Binding IsMulti}">
                        <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Label}"/>
                        <Panel>
                          <Button Theme="{StaticResource Toggle}" IsVisible="{Binding IsBoolean}"
                                  Classes.on="{Binding IsOn}"
                                  auto:AutomationProperties.Name="{Binding Label}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleQuestionCommand}"
                                  CommandParameter="{Binding}"/>
                          <ItemsControl IsVisible="{Binding IsSingle}" ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="{StaticResource Space1}" LineSpacing="{StaticResource Space1}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ChoiceOption">
                                <Button Theme="{StaticResource Segment}"
                                        Classes.selected="{Binding IsSelected}"
                                        Content="{Binding Label}"
                                        auto:AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).ChooseCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl IsVisible="{Binding IsMulti}" ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="{StaticResource Space1}" LineSpacing="{StaticResource Space1}"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ChoiceOption">
                                <Button Theme="{StaticResource Chip}"
                                        Classes.selected="{Binding IsSelected}"
                                        Content="{Binding Label}"
                                        auto:AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).ChooseCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Panel>
                      </ctl:QuestionRow>
                    </Border>
                  </DataTemplate>
                </Border.Resources>
                <StackPanel Spacing="{StaticResource FieldStack}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource RowGap}">
                    <TextBlock Theme="{StaticResource H3}" VerticalAlignment="Center" Text="{loc:Text questions.title}"/>
                    <Button x:Name="ResetButton" Grid.Column="1" Theme="{StaticResource HeaderButton}"
                            IsVisible="{Binding HasCard}"
                            Content="{loc:Text questions.reset}"
                            Command="{Binding ResetAnswersCommand}"/>
                  </Grid>
                  <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text questions.empty}"
                             IsVisible="{Binding ShowQuestionHint}"/>
                  <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text questions.hint}"
                             IsVisible="{Binding HasCard}"/>
                  <ItemsControl x:Name="QuestionList" ItemsSource="{Binding OpenQuestions}" IsVisible="{Binding HasCard}"
                                ItemTemplate="{StaticResource QuestionRowTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ctl:QuestionGrid ColumnMin="{StaticResource QuestionColumnMin}"
                                          ColumnsMax="{StaticResource QuestionColumnsMax}"
                                          Spacing="{StaticResource FieldGap}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <StackPanel x:Name="ChosenGroup" Spacing="{StaticResource FieldGap}">
                    <StackPanel.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasCard"/>
                        <Binding Path="HasChosen"/>
                      </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Theme="{StaticResource Label}" Text="{loc:Text questions.chosen}"/>
                    <ItemsControl x:Name="ChosenList" ItemsSource="{Binding ChosenQuestions}"
                                  ItemTemplate="{StaticResource QuestionRowTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <ctl:QuestionGrid ColumnMin="{StaticResource QuestionColumnMin}"
                                            ColumnsMax="{StaticResource QuestionColumnsMax}"
                                            Spacing="{StaticResource FieldGap}"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border x:Name="DrawerScrim" Background="Transparent" IsVisible="False"/>

        <Border x:Name="SyndromeRail" Theme="{StaticResource Panel}"
                HorizontalAlignment="Left" Width="{StaticResource SidebarWidth}">
          <DockPanel VerticalSpacing="{StaticResource FieldStack}">
            <TextBlock DockPanel.Dock="Top" Theme="{StaticResource H3}" Text="{loc:Text rail.title}"/>
            <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource FieldGap}">
              <TextBlock x:Name="SearchLabel" Theme="{StaticResource Label}" Text="{loc:Text rail.search}"/>
              <TextBox x:Name="SearchBox" Text="{Binding SearchText}"
                       MinHeight="{StaticResource InputHeight}"
                       Padding="{StaticResource InputPadding}"
                       VerticalContentAlignment="Center"
                       CornerRadius="{StaticResource Radius}"
                       FontFamily="{StaticResource FontSans}"
                       FontSize="{StaticResource FontSize1}"
                       Foreground="{StaticResource TextBody}"
                       CaretBrush="{StaticResource NeonBlue}"
                       SelectionBrush="{StaticResource NeonBlue30}"
                       SelectionForegroundBrush="{StaticResource OnBlue30}">
                <TextBox.Resources>
                  <StaticResource x:Key="TextControlBackground" ResourceKey="AppBg"/>
                  <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AppBg"/>
                  <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="AppBg"/>
                  <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderDefault"/>
                  <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderStrong"/>
                  <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="NeonBlue"/>
                  <StaticResource x:Key="TextControlForeground" ResourceKey="TextBody"/>
                  <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBody"/>
                  <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBody"/>
                </TextBox.Resources>
              </TextBox>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Theme="{StaticResource Hint}" Text="{loc:Text rail.empty}"
                       IsVisible="{Binding NoSyndromes}"/>
            <TextBlock DockPanel.Dock="Top" Theme="{StaticResource Hint}" Text="{loc:Text rail.noMatch}"
                       IsVisible="{Binding NoMatches}"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="SyndromeList" ItemsSource="{Binding Syndromes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource Space1}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SyndromeItem">
                    <Button Theme="{StaticResource RailItem}"
                            IsVisible="{Binding IsMatch}"
                            Classes.selected="{Binding IsSelected}"
                            Content="{Binding Name}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectSyndromeCommand}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border x:Name="SettingsPanel" Theme="{StaticResource Panel}"
                Background="{StaticResource AppBg}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                MaxWidth="{StaticResource ModalWidth}"
                IsVisible="False">
          <StackPanel Spacing="{StaticResource FieldStack}">
            <DockPanel>
              <Button x:Name="SettingsClose" DockPanel.Dock="Right" Theme="{StaticResource HeaderButton}"
                      Content="{loc:Text settings.close}"
                      Command="{Binding CloseSettingsCommand}"/>
              <TextBlock Theme="{StaticResource H3}" VerticalAlignment="Center" Text="{loc:Text settings.title}"/>
            </DockPanel>
            <StackPanel Spacing="{StaticResource FieldGap}">
              <TextBlock Theme="{StaticResource Label}" Text="{Binding GuidelineSettingLabel}"/>
              <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding NoSetChoices}"
                         Text="{loc:Text settings.guidelineNone}"/>
              <ItemsControl ItemsSource="{Binding GuidelineSets}" IsVisible="{Binding HasSetChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="{StaticResource FieldGap}" LineSpacing="{StaticResource FieldGap}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <Button Theme="{StaticResource HeaderButton}"
                            Classes.selected="{Binding IsSelected}"
                            Content="{Binding Label}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectGuidelineSetCommand}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding HasSetChoices}"
                         Text="{loc:Text settings.guidelineHint}"/>
            </StackPanel>
            <StackPanel Spacing="{StaticResource FieldGap}">
              <TextBlock Theme="{StaticResource Label}" Text="{loc:Text settings.region}"/>
              <ItemsControl ItemsSource="{Binding Regions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="{StaticResource FieldGap}" LineSpacing="{StaticResource FieldGap}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <Button Theme="{StaticResource HeaderButton}"
                            Classes.selected="{Binding IsSelected}"
                            Content="{Binding Label}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectRegionCommand}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings.regionHint}"/>
            </StackPanel>
            <StackPanel Spacing="{StaticResource FieldGap}">
              <TextBlock Theme="{StaticResource Label}" Text="{loc:Text settings.language}"/>
              <ItemsControl ItemsSource="{Binding Languages}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="{StaticResource FieldGap}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <Button Theme="{StaticResource HeaderButton}"
                            Classes.selected="{Binding IsSelected}"
                            Content="{Binding Label}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectLanguageCommand}"
                            CommandParameter="{Binding Code}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="{StaticResource FieldGap}">
              <ToggleButton x:Name="ScoreSwitch" Theme="{StaticResource Switch}"
                            IsChecked="{Binding ShowScore}"
                            Content="{loc:Text settings.showScore}"/>
              <TextBlock Theme="{StaticResource Hint}" Text="{loc:Text settings.showScoreHint}"/>
            </StackPanel>
            <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding SettingsPath}"/>
          </StackPanel>
        </Border>

      </Panel>

    <Canvas x:Name="HintLayer" IsHitTestVisible="False">
      <Border x:Name="NoEffectHint" Theme="{StaticResource Badge}" Background="{StaticResource Surface}" Opacity="0">
        <TextBlock Theme="{StaticResource Hint}" Text="{Binding NoEffectText}"/>
      </Border>
    </Canvas>

  </Panel>
</UserControl>
