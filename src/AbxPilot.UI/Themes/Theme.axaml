<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="LinkGitHub">https://github.com/Teknesyum</x:String>
  <x:String x:Key="LinkSponsor">https://github.com/sponsors/Teknesyum</x:String>

  <x:Double x:Key="WindowWorkAreaShare">0.9</x:Double>
  <x:Double x:Key="WindowMinWidth">960</x:Double>
  <x:Double x:Key="WindowMinHeight">600</x:Double>

  <x:Double x:Key="CompactBreakpoint">720</x:Double>
  <x:Double x:Key="CardHeightShare">0.5</x:Double>
  <x:Double x:Key="QuestionColumnMin">420</x:Double>
  <x:Double x:Key="QuestionLabelMin">120</x:Double>
  <x:Int32 x:Key="QuestionColumnsMax">4</x:Int32>

</ResourceDictionary>
