<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ch="using:AbxPilot.UI.Choreography">

  <Styles.Resources>

    <ControlTheme x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Renk1}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDecorative}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="{StaticResource TInstant}"
                                               Easing="{StaticResource EOut}"/>
                <BrushTransition Property="BorderBrush" Duration="{StaticResource TInstant}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^.selected">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </Style>
      <Style Selector="^.selected /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Style Selector="^:vertical">
        <Setter Property="Width" Value="{StaticResource ScrollbarWidth}"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Thumb Name="thumb"/>
            </Track>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:horizontal">
        <Setter Property="Height" Value="{StaticResource ScrollbarWidth}"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}">
              <Thumb Name="thumb"/>
            </Track>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^ /template/ Thumb#thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius}"/>
          </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{StaticResource Renk1x30}"/>
      </Style>
      <Style Selector="^ /template/ Thumb#thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource Renk1x50}"/>
      </Style>
    </ControlTheme>

    <StaticResource x:Key="ToolTipBackground" ResourceKey="AppBg"/>
    <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBody"/>
    <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderDefault"/>

    <ControlTheme x:Key="RailItem" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="MinHeight" Value="{StaticResource InputHeight}"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="{StaticResource TInstant}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              TextWrapping="Wrap"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.selected">
        <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk1x10}"/>
      </Style>
      <Style Selector="^.selected:pointerover">
        <Setter Property="Foreground" Value="{StaticResource OnRenk1x10}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Badge" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="{Binding Source={StaticResource Space2}, Converter={x:Static ch:Converters.Inset}}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <ControlTheme x:Key="WarningBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
      <Setter Property="BorderBrush" Value="{StaticResource Warning50}"/>
    </ControlTheme>

    <ControlTheme x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <Border Name="bd" Background="Transparent" BorderBrush="Transparent"
                  BorderThickness="{StaticResource BorderWidth}" CornerRadius="{StaticResource Radius}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource RowGap}">
            <ContentPresenter Name="PART_ContentPresenter" Grid.Column="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{StaticResource TextBody}"
                              VerticalAlignment="Center"/>
            <Border Name="track" Grid.Column="1"
                    Width="{StaticResource InputHeight}" Height="{StaticResource TargetMin}"
                    CornerRadius="{StaticResource Radius}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="{StaticResource BorderWidth}"
                    Background="Transparent"
                    Padding="{Binding Source={StaticResource Space1}, Converter={x:Static ch:Converters.Inset}}">
              <Ellipse Name="knob" Width="{StaticResource Space4}" Height="{StaticResource Space4}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{StaticResource Renk1}">
                <Ellipse.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource TFast}"
                                                   Easing="{StaticResource EOut}"/>
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
            </Border>
          </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#track">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:focus-visible /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^:checked /template/ Border#track">
        <Setter Property="Background" Value="{StaticResource Renk1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^:checked /template/ Ellipse#knob">
        <Setter Property="Fill" Value="{StaticResource OnRenk1}"/>
        <Setter Property="RenderTransform" Value="{Binding Source={StaticResource Space4}, Converter={x:Static ch:Converters.ShiftX}}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Toggle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="{Binding Source={StaticResource Space1}, Converter={x:Static ch:Converters.Inset}}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border Name="track"
                    Width="{StaticResource InputHeight}" Height="{StaticResource TargetMin}"
                    CornerRadius="{StaticResource Radius}"
                    BorderBrush="{StaticResource BorderDecorative}"
                    BorderThickness="{StaticResource BorderWidth}"
                    Background="Transparent"
                    Padding="{Binding Source={StaticResource Space1}, Converter={x:Static ch:Converters.Inset}}">
              <Ellipse Name="knob" Width="{StaticResource Space4}" Height="{StaticResource Space4}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="Transparent" Stroke="{StaticResource Renk1}"
                       StrokeThickness="{StaticResource FocusWidth}">
                <Ellipse.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource TFast}"
                                                   Easing="{StaticResource EOut}"/>
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#track">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:focus-visible /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^.on /template/ Border#track">
        <Setter Property="Background" Value="{StaticResource Renk1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^.on /template/ Ellipse#knob">
        <Setter Property="Fill" Value="{StaticResource OnRenk1}"/>
        <Setter Property="Stroke" Value="{StaticResource OnRenk1}"/>
        <Setter Property="RenderTransform" Value="{Binding Source={StaticResource Space4}, Converter={x:Static ch:Converters.ShiftX}}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Segment" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDecorative}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="Padding" Value="{Binding Source={StaticResource Space2}, Converter={x:Static ch:Converters.Sides}}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Panel>
            <Border Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="50%,50%">
              <Border.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform"
                                                 Duration="{StaticResource TInstant}"
                                                 Easing="{StaticResource EOut}"/>
                  <BrushTransition Property="BorderBrush" Duration="{StaticResource TInstant}"/>
                </Transitions>
              </Border.Transitions>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
            </Border>
            <Border Name="ring" IsVisible="False" IsHitTestVisible="False"
                    BorderBrush="{StaticResource TextBody}"
                    BorderThickness="{StaticResource BorderWidth}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:focus-visible /template/ Border#ring">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^.selected">
        <Setter Property="Background" Value="{StaticResource Renk1}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^.selected:pointerover">
        <Setter Property="Foreground" Value="{StaticResource OnRenk1}"/>
      </Style>
      <Style Selector="^.selected:pointerover /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Segment}"/>

    <ControlTheme x:Key="Skeleton" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="MinHeight" Value="{StaticResource InputHeight}"/>
    </ControlTheme>

    <ControlTheme x:Key="SkeletonBar" TargetType="Border" BasedOn="{StaticResource Skeleton}">
      <Setter Property="MinHeight" Value="{StaticResource Space3}"/>
    </ControlTheme>

  </Styles.Resources>

  <Style Selector="Border.consult">
    <Setter Property="BorderBrush" Value="{StaticResource Warning}"/>
  </Style>

  <Style Selector="Border.clear">
    <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
  </Style>

  <Style Selector="Border.qcard">
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderDecorative}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
    <Setter Property="Padding" Value="{Binding Source={StaticResource Space2}, Converter={x:Static ch:Converters.Inset}}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,0%"/>
  </Style>

  <Style Selector="Border.qcard.changed">
    <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
  </Style>

  <Style Selector="TransitioningContentControl.headline">
    <Setter Property="FontSize" Value="{StaticResource FontSize5}"/>
    <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
    <Setter Property="Foreground" Value="{StaticResource Renk1}"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>

  <Style Selector="TransitioningContentControl.headline.caution">
    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
  </Style>

  <Style Selector="TransitioningContentControl.headline.clear">
    <Setter Property="Foreground" Value="{StaticResource Success}"/>
  </Style>

  <Style Selector="TextBlock.tag">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <Style Selector="Border.fill.variable">
    <Setter Property="Background" Value="{StaticResource Renk1x50}"/>
  </Style>

  <Style Selector=".anim Border.alt">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{StaticResource TFast}" Easing="{StaticResource EIn}"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.alt.leaving">
    <Setter Property="Opacity" Value="0"/>
  </Style>

  <Style Selector="Border.fill">
    <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
    <Setter Property="Background" Value="{StaticResource Renk1}"/>
  </Style>

  <Style Selector=".anim Border.fill">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TBase}" Easing="{StaticResource EOut}"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.flash">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
    <Setter Property="Effect" Value="{StaticResource HeroGlow}"/>
  </Style>

  <Style Selector=".anim Border.enter">
    <Style.Animations>
      <Animation Duration="{StaticResource TBase}" Easing="{StaticResource EOut}" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="TranslateTransform.Y" Value="{StaticResource EntryOffset}"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="TranslateTransform.Y" Value="0"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
