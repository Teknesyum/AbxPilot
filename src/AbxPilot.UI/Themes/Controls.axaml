<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <ControlTheme x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDecorative}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize1}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="{StaticResource TInstant}"
                                               Easing="{StaticResource EOut}"/>
                <BrushTransition Property="BorderBrush" Duration="{StaticResource TInstant}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource NeonPink}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^.selected">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </Style>
      <Style Selector="^.selected /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="WindowControlButton" TargetType="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Width" Value="{StaticResource TitleBarHeightMax}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{StaticResource TInstant}"/>
              </Transitions>
            </Border.Transitions>
            <Panel>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
              <Border Name="FocusRing"
                      IsHitTestVisible="False"
                      BorderBrush="Transparent"
                      BorderThickness="{StaticResource BorderWidth}"/>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="Black"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{StaticResource NeonPurple}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#Root">
        <Setter Property="Opacity" Value="0.85"/>
      </Style>
      <Style Selector="^:focus-visible /template/ Border#FocusRing">
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      <Style Selector="^:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{StaticResource NeonPink}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Skeleton" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource NeonBlue10}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="MinHeight" Value="{StaticResource InputHeight}"/>
    </ControlTheme>

    <ControlTheme x:Key="SkeletonBar" TargetType="Border" BasedOn="{StaticResource Skeleton}">
      <Setter Property="MinHeight" Value="{StaticResource Space3}"/>
    </ControlTheme>

  </Styles.Resources>

  <Style Selector=".anim Border.enter">
    <Style.Animations>
      <Animation Duration="{StaticResource TBase}" Easing="{StaticResource EOut}" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="TranslateTransform.Y" Value="{StaticResource EntryOffset}"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="TranslateTransform.Y" Value="0"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
